# Copy this file to ".env" and fill in the values.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your server (guild) ID. Used to sync slash commands instantly to your server.
# Right-click your server icon -> Copy Server ID (Developer Mode must be on).
GUILD_ID=

# Shared timezone for the whole server. Determines "today" and when the
# Sun-Sat week rolls over. Use an IANA name, e.g. America/Chicago,
# America/New_York, America/Los_Angeles, Europe/London.
TIMEZONE=America/Chicago

# Where the SQLite database file lives (relative paths are fine).
DATABASE_PATH=data/tracker.db
